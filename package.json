{
  "name": "obsidian-claude-research",
  "version": "0.1.0",
  "description": "Claude in Obsidian: Chat, Web-Recherche mit Quellen und Handschrift-Transkription.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "esbuild test/run.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./test/obsidian-stub.ts --outfile=test/.out/run.test.cjs --log-level=warning && node test/.out/run.test.cjs"
  },
  "keywords": [
    "obsidian",
    "claude",
    "anthropic",
    "research",
    "handwriting"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0"
  }
}
